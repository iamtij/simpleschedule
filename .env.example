NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://isked:isked_dev@localhost:5432/isked_dev
SESSION_SECRET=your-secret-key

# Email — Resend (preferred). When RESEND_API_KEY is set, all app email uses Resend.
RESEND_API_KEY=
# Optional; defaults to notify@isked.app (from header: ISKED <notify@isked.app>)
RESEND_FROM=

# Email — Mailgun (fallback when RESEND_API_KEY is not set)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_EU=true
# MAILGUN_URL=https://api.eu.mailgun.net

# SMS (Semaphore — Philippines). See docs/SMS_IMPLEMENTATION.md
SEMAPHORE_API_KEY=
BASE_URL=http://localhost:3000

# Optional: Railway production Postgres public URL (from Railway → Postgres → Connect)
# Used for manual migrations from your machine. Do not commit real values — copy to .env only.
RAILWAY_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
